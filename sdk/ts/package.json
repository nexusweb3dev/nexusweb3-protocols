{
  "name": "@nexusweb3/sdk",
  "version": "2.0.0",
  "description": "TypeScript SDK and MCP server for the NexusWeb3 v2 agent protocol stack (identity, reputation, kill switch, audit log, milestone escrow).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "import": "./dist/mcp/index.js"
    }
  },
  "bin": {
    "nexusweb3-mcp": "./dist/mcp/index.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "e2e": "tsx scripts/e2e.ts",
    "abi:sync": "node scripts/sync-abis.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.2",
    "viem": "^2.38.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
